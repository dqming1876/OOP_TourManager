{
  "name": "mingo-local",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin.js"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "mingo-local",
    "database_id": "00000000-0000-4000-8000-000000000001",
    "migrations_dir": "Database"
  }],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
