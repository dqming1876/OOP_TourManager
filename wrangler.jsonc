{
  "name": "mingo",
  "account_id": "a4d4ba32c45359ddb8a6665bdb702450",
  "main": "entry.py",
  "compatibility_flags": ["python_workers"],
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin.js"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "mingo",
    "database_id": "b378e40e-886d-4f71-aeee-58a16e306718",
    "migrations_dir": "Database"
  }],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
